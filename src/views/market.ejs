<!doctype html>
<html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#0d0d0f"><title>Stratic Market</title><link rel="stylesheet" href="/static/css/market.css"></head>
<body>
<header class="mk-top"><div class="mk-logo">✦ Stratic Market<small>VIDEO MARKETPLACE</small></div><span class="mk-online"><i></i><b id="online">1</b> online</span></header>
<main id="feed" class="mk-feed"><p class="mk-empty" id="empty">Loading…</p></main>
<nav class="mk-nav"><a href="/market" class="on">⌂<span>Home</span></a><a href="/shop">Shop</a><button id="open-upload" class="mk-plus" aria-label="Upload video">+</button><a href="/track">Orders</a><a href="/book-parcel">Parcel</a></nav>
<dialog id="up"><form id="up-form" enctype="multipart/form-data">
<div class="mk-row"><h2>Upload Video</h2><button type="button" id="up-close" class="mk-x">✕</button></div>
<label class="mk-rec">🎥 <span id="file-name">Tap to record / choose video</span><input type="file" name="video" accept="video/mp4,video/webm,video/quicktime" capture="environment" required></label>
<label>Shop / seller name<input name="shop" maxlength="60" required placeholder="Ahmed Fashion, Dehradun"></label>
<label>Title<input name="title" maxlength="140" required placeholder="New cotton kurta collection"></label>
<label>Hashtags<input name="tags" maxlength="100" placeholder="#clothing #kurta"></label>
<label>Countries your parcels reached (comma separated)<input name="countries" maxlength="600" placeholder="India, UAE, USA"></label>
<label>Shop Now link (optional)<input name="link" type="url" maxlength="300" placeholder="https://..."></label>
<p id="up-msg" role="status"></p>
<div class="mk-row"><button type="button" id="up-cancel" class="mk-btn dark">Cancel</button><button type="submit" class="mk-btn">Post Video</button></div>
</form></dialog>
<script src="/static/js/market.js" defer></script>
</body></html>
