<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#101010"><title>Private Dashboard · Stratic Market</title>
<style>
:root{--orange:#f5660a;--ink:#141414;--muted:#6b7280;--line:#e7e7e7;--bg:#f5f6f8}*{box-sizing:border-box}
body{margin:0;background:var(--bg);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink)}
header{background:#101010;color:#fff;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px}
header strong{font-size:21px;letter-spacing:-.5px}header strong span{color:var(--orange)}header small{color:#c8c8c8}
.wrap{max-width:1280px;margin:22px auto;padding:0 16px}
.panel{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:0 6px 22px #00000008;margin-bottom:16px}
.login{max-width:420px;margin:9vh auto}.hint{color:var(--muted);font-size:13px}
input{width:100%;padding:14px;border:1px solid #d8d8d8;border-radius:10px;font:inherit;margin:10px 0 14px}
button{border:0;border-radius:11px;padding:11px 18px;background:var(--orange);color:#fff;font:600 14px system-ui;cursor:pointer}
button.secondary{background:#222}button:disabled{opacity:.6}.error{color:#b42318;min-height:20px}
.stats{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;margin-bottom:16px}
.stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:15px}.stat small{color:var(--muted);display:block;font-size:12px}
.stat strong{font-size:26px;display:block;margin-top:3px}.stat.g strong{color:#067d62}.stat.o strong{color:var(--orange)}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:16px}
h2{font-size:17px;margin:0 0 12px}.table-wrap{overflow:auto;max-height:420px}
table{width:100%;border-collapse:collapse;white-space:nowrap}th,td{text-align:left;padding:9px 11px;border-bottom:1px solid #eee;font-size:13px}
th{background:#fafafa;color:#555;position:sticky;top:0}td{max-width:300px;overflow:hidden;text-overflow:ellipsis}
.pill{display:inline-block;padding:2px 9px;border-radius:99px;background:#e9f8ef;color:#17663a;font-size:12px;font-weight:600}
.pill.SHIPPED{background:#e8f0fe;color:#1a56c4}.pill.DELIVERED{background:#e9f8ef;color:#0b6b3a}.pill.CANCELLED{background:#fdeceb;color:#b42318}
.bar{height:8px;border-radius:6px;background:#eee;overflow:hidden;min-width:80px}.bar i{display:block;height:100%;background:var(--orange)}
.topline{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}.hidden{display:none!important}
@media(max-width:1000px){.stats{grid-template-columns:repeat(3,minmax(0,1fr))}.cols{grid-template-columns:1fr}}
@media(max-width:560px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.stat strong{font-size:22px}}
</style></head><body>
<header><div><strong>stratic<span>market</span></strong><br><small>Private owner dashboard</small></div><a href="/shop" style="color:#fff;text-decoration:none;font-size:13px">Open public shop ↗</a></header>
<div class="wrap">
<section id="login-panel" class="panel login"><h1 style="margin-top:0">Private Dashboard</h1><p class="hint">Owner access only. Enter the dashboard password.</p>
<form id="login-form"><label for="password">Dashboard password</label><input id="password" name="password" type="password" autocomplete="current-password" required>
<button id="login-btn" type="submit" style="width:100%">Unlock dashboard</button><p id="login-error" class="error" role="alert"></p></form></section>
<section id="dashboard" class="hidden">
<div class="topline"><div><h1 style="margin:0">Marketplace overview</h1><p class="hint" style="margin:4px 0">Auto-refreshes every 30 seconds. Views = shop page opens (not unique people).</p></div>
<div><button class="secondary" id="refresh">Refresh</button> <button class="secondary" id="logout">Log out</button></div></div>
<div class="stats">
<div class="stat"><small>Shop page views</small><strong id="visits">—</strong></div>
<div class="stat"><small>Registered users</small><strong id="users">—</strong></div>
<div class="stat"><small>Active now (15 min)</small><strong id="activeNow">—</strong></div>
<div class="stat"><small>Active last 24h</small><strong id="active24h">—</strong></div>
<div class="stat"><small>New users (7 days)</small><strong id="newUsers7d">—</strong></div>
<div class="stat"><small>Sellers</small><strong id="sellers">—</strong></div>
<div class="stat o"><small>Products listed</small><strong id="products">—</strong></div>
<div class="stat"><small>Buyers</small><strong id="buyers">—</strong></div>
<div class="stat o"><small>Total orders</small><strong id="orders">—</strong></div>
<div class="stat g"><small>Confirmed</small><strong id="s-CONFIRMED">0</strong></div>
<div class="stat"><small>Shipped / Delivered</small><strong id="s-SD">0</strong></div>
<div class="stat"><small>Cancelled</small><strong id="s-CANCELLED">0</strong></div>
</div>
<div class="panel"><h2>Sales value (excluding cancelled)</h2><div id="sales" class="hint">—</div></div>
<div class="cols">
<div class="panel"><h2>Countries</h2><div class="table-wrap"><table><thead><tr><th>Country</th><th>Users</th><th>Products</th><th>Orders</th><th></th></tr></thead><tbody id="countries"></tbody></table></div></div>
<div class="panel"><h2>Products by category</h2><div class="table-wrap"><table><thead><tr><th>Category</th><th>Products</th><th></th></tr></thead><tbody id="cats"></tbody></table></div></div>
</div>
<div class="panel"><h2>Recent orders</h2><div class="table-wrap"><table><thead><tr><th>Order ID</th><th>Status</th><th>Items</th><th>Total</th><th>Buyer</th><th>Phone</th><th>City / Country</th><th>Seller</th><th>Date</th></tr></thead><tbody id="recent-orders"></tbody></table></div></div>
<div class="panel"><h2>Online payments <span id="online-total" class="hint"></span></h2><div id="pay-sum" style="margin:6px 0 12px;line-height:2.1"></div><div class="table-wrap"><table><thead><tr><th>Date &amp; time</th><th>Order ID</th><th>Buyer</th><th>Phone</th><th>Amount</th><th>Transaction ID / UTR</th><th>Items</th><th>Seller</th><th>Order status</th><th>Payment</th></tr></thead><tbody id="online-pay"></tbody></table></div></div>
<div class="panel"><h2>Recent users</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Country</th><th>Joined</th><th>Last seen</th></tr></thead><tbody id="recent-users"></tbody></table></div></div>
<div class="panel"><h2>Recent products</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Seller / shop</th><th>Seller phone</th><th>Country</th><th>Price</th><th>Uploaded</th></tr></thead><tbody id="recent-products"></tbody></table></div></div>
<div class="cols">
<div class="panel"><h2>Daily shop views</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Views</th></tr></thead><tbody id="daily-visits"></tbody></table></div></div>
<div class="panel"><h2>Daily orders</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Orders</th></tr></thead><tbody id="daily-orders"></tbody></table></div></div>
</div>
</section><p id="load-error" class="error"></p></div>
<script src="/static/js/admin.js?v=20261024-final"></script></body></html>
