<% layout('layout') -%>
<section class="page-heading"><div class="eyebrow">PARCEL REQUEST</div><h1><%= t.bookParcel %></h1><p>Enter sender, receiver and parcel details. Your request reference is not a courier tracking number.</p></section>
<form class="panel form-grid" id="booking-form">
<h2 class="full">Sender details</h2><label><%= t.name %><input name="senderName" required minlength="2" maxlength="100"></label><label><%= t.phoneNumber %><input name="senderPhone" required autocomplete="tel" placeholder="+91..."></label><label><%= t.country %><input name="senderCountry" required value="IN" maxlength="2" pattern="[A-Za-z]{2}"></label><label><%= t.state %><input name="senderState" maxlength="100"></label><label><%= t.postalCode %><input name="senderPostalCode" required maxlength="20"></label>
<h2 class="full"><%= t.receiver %></h2><label><%= t.name %><input name="receiverName" required minlength="2" maxlength="100"></label><label><%= t.phoneNumber %><input name="receiverPhone" required autocomplete="tel"></label><label><%= t.country %><input name="receiverCountry" required value="IN" maxlength="2" pattern="[A-Za-z]{2}"></label><label><%= t.state %><input name="receiverState" maxlength="100"></label><label><%= t.postalCode %><input name="receiverPostalCode" required maxlength="20"></label>
<h2 class="full"><%= t.parcelDetails %></h2><label class="full"><%= t.description %><textarea name="parcelDescription" required minlength="3" maxlength="500"></textarea></label><label><%= t.weight %><input type="number" name="weightGrams" required min="1" max="100000"></label><label>Length (cm)<input type="number" name="lengthCm" min="1" max="300" step="0.1"></label><label>Width (cm)<input type="number" name="widthCm" min="1" max="300" step="0.1"></label><label>Height (cm)<input type="number" name="heightCm" min="1" max="300" step="0.1"></label><label>Declared value<input type="number" name="declaredValue" min="0" step="0.01"></label><label>Currency (ISO)<input name="currency" value="INR" minlength="3" maxlength="3"></label><label class="full">Parcel photo/video (optional, disabled until secure storage is configured)<input type="file" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" disabled><small>Media upload is disabled until durable private storage, scanning and access controls are configured.</small></label><label class="full consent"><input type="checkbox" required> I understand this creates a request only; it does not confirm a courier booking or price.</label><button class="button primary full" type="submit"><%= t.submit %></button><p class="full" id="booking-result" role="status"></p></form>
