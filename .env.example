# ============================================================
# STRATIC MARKET: सारे Environment Variables (Render / Railway / कोई भी होस्ट)
# नया होस्ट लेने पर यही सब वहाँ के Environment / Variables सेक्शन में भरें।
# ============================================================

# ---- ज़रूरी ----
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SESSION_SECRET=change-me-long-random-32-characters-or-more
APP_URL=https://your-new-site-link
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-new-site-link/shop/api/google/callback
ADMIN_PASSWORD=
# Render के अलावा किसी भी होस्ट पर ये ज़रूर डालें (सुरक्षित कुकी के लिए):
NODE_ENV=production

# ---- ईमेल (Brevo) ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Stratic Market

# ---- फोटो बैकअप (वैकल्पिक) ----
GETPRONTO_API_KEY=
IMG_DATABASE_URL=

# ---- STRATIC MARKET CHAT ----
# चैट के लिए कोई key या वेबसाइट नहीं चाहिए। चैट अपने आप चालू रहता है।
# बंद करना हो तो ही नीचे false लिखें।
CHAT_ENABLED=true

# ---- बाकी वैकल्पिक (जो पहले से Render में हों वही कॉपी करें) ----
DATA_DIR=
UPLOAD_MAX_BYTES=
OTP_PROVIDER=
OTP_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
CARRIER_PROVIDER=
CARRIER_API_KEY=
CARRIER_BASE_URL=
# PORT: होस्ट खुद देता है, अपने से मत डालें।
